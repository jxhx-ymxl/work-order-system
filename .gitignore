# ==========================================
# 1. Maven 编译产物
# ==========================================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# 保留 Maven Wrapper 自举能力（核心修复）
.mvn/
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
!.mvn/wrapper/maven-wrapper.properties

# ==========================================
# 2. 敏感私有配置与环境变量（核心修复）
# ==========================================
.env
.env.*
application-local.yml
application-local.properties
application-dev.yml
application-dev.properties

# ==========================================
# 3. 日志文件
# ==========================================
*.log
log/
logs/

# ==========================================
# 4. IDE 与 操作系统配置
# ==========================================
.idea/
*.iml
*.iws
*.ipr
.vscode/
.DS_Store
Thumbs.db

# ==========================================
# 5. 内部自审文档（不入库——含对实现与文档漂移的自曝，公开仓库会减分）
# ==========================================
docs/CODE-REVIEW-REPORT.md
docs/INTERVIEW-NARRATIVE.md
docs/INTERVIEW-STAR.md
# 本机实测专用(端口冲突规避), 不入库
deploy/docker-compose.local.yml

# ==========================================
# 6. 工具骨架目录（不入库）
# ==========================================
# .spec-workflow/ 是规格工作流工具的目录骨架：specs/steering/approvals/archive 均为空，
# 仅 templates/ 与 user-templates/ 含通用英文模板，不属于本项目的业务或设计内容。
# 保留目录本身（工具仍在用），只忽略其内容。
.spec-workflow/

# ==========================================
# 7. 前端构建产物（单仓内的 frontend/）
# ==========================================
# frontend/ 自带 .gitignore 也覆盖了这两项；这里再写一次是因为根 .gitignore 是
# 仓库级防线——若将来 frontend/.gitignore 被误删，构建产物仍不会被误提交。
frontend/node_modules/
frontend/dist/
