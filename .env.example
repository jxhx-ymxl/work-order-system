# ============================================================
# 环境变量样例（只含键名与说明，**不含任何真实值**）
#
# 用法：
#   1) 复制为 .env（`.env` 已被 .gitignore 覆盖，不会入库）
#   2) 在本地或服务器上填入真实值
#   3) Docker Compose 会自动读取同目录下的 .env；用非 compose 方式启动时需自行 export
#
# 占位符约定：
#   <required>  = 必须由部署者提供，代码里没有可用的默认值
#   <optional>  = 有默认值，仅在需要覆盖时填写
#   <not-used>  = 当前代码尚未消费，为 P1/P2 预留（填了也不生效）
# ============================================================

# ── MySQL（后端连接用；当前已被代码消费：application.yml 的 spring.datasource）──
MYSQL_HOST=<optional:localhost>
MYSQL_PORT=<optional:3306>
DB_NAME=<optional:work_order>
MYSQL_USER=<optional:root>
# 注意：这里**没有** MYSQL_PASSWORD 这一项——它是一个"写了不生效"的死配置。
#   原因：compose 里后端的环境变量 MYSQL_PASSWORD 取自 ${MYSQL_ROOT_PASSWORD}，
#   也就是说后端实际是用 **MySQL root 账号**连库的（演示环境取舍，生产应改为最小权限专用用户）。
#   你自己设的 MYSQL_PASSWORD 会被 compose 覆盖，永远不会生效，故移除以免误导。
#   要改后端连库口令，就改下面的 MYSQL_ROOT_PASSWORD。

# ── MySQL 容器初始化（仅 docker-compose 用；决定容器 root 口令与首次建库）──
# 不再保留 "WorkOrder@2026" 这类真实感默认值：留默认值等于把口令写进公开历史
MYSQL_ROOT_PASSWORD=<required>

# ── Redis（当前已被代码消费：spring.data.redis + Sa-Token 会话）──
REDIS_HOST=<optional:localhost>
REDIS_PORT=<optional:6379>

# ── LLM 智能分诊（当前已被代码消费：OrderTriageServiceImpl 读取 llm.api.url/key）──
# 两个都为空时走「静默降级」：type=OTHER、priority=0，不影响提交
LLM_API_URL=<optional:空>
LLM_API_KEY=<optional:空>

# ── RabbitMQ（保留键名，P1 接入后才生效）──
# 现状：application.yml 里的 rabbitmq 段是**硬编码** localhost:5672 / guest / guest，
#       不接受环境变量覆盖（见 README 的体检结论）。P1 接入时必须改为读取下列变量。
RABBITMQ_HOST=<not-used:localhost>
RABBITMQ_PORT=<not-used:5672>
RABBITMQ_USER=<not-used:guest>
RABBITMQ_PASS=<not-used:guest>

# ── 测试专用（仅 mvn test 时使用；见 src/test/resources/application-test.yml）──
# 测试必须用独立的库与独立的 Redis DB，避免污染业务库/清掉应用正在用的键
TEST_DB_NAME=<optional:work_order_test>
TEST_REDIS_DB=<optional:1>
