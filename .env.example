# ============================================================
# 环境变量样例（只含键名与说明，**不含任何真实值**）
#
# 用法：
#   1) 复制为 deploy/.env —— **必须与 compose 文件同级**（实测：compose 按 compose 文件所在目录找 .env，
#      放仓库根目录会读不到，表现为 `required variable ... is missing a value` 起不来；
#      `.env` 已被 .gitignore 覆盖，不会入库）
#   2) 在本地或服务器上填入真实值
#   3) Docker Compose 会自动读取同目录下的 .env；用非 compose 方式启动时需自行 export
#
# 占位符约定：
#   <required>  = 必须由部署者提供，代码里没有可用的默认值
#   <optional>  = 有默认值，仅在需要覆盖时填写
#   <not-used>  = 当前代码尚未消费，为 P1/P2 预留（填了也不生效）
# ============================================================

# ── MySQL（后端连接用；当前已被代码消费：application.yml 的 spring.datasource）──
# 注意：**compose 部署时这几个键由 compose 传进容器**，默认值就是容器网络内的服务名（mysql / 3306 / work_order / root）。
#   留空即可；若在这里写 localhost，容器里的 localhost 指容器自己 → 连不上（D47 / D57）。
MYSQL_HOST=<optional:localhost>
MYSQL_PORT=<optional:3306>
DB_NAME=<optional:work_order>
MYSQL_USER=<optional:root>
# 注意：这里**没有** MYSQL_PASSWORD 这一项——它是一个"写了不生效"的死配置。
#   原因：compose 里后端的环境变量 MYSQL_PASSWORD 取自 ${MYSQL_ROOT_PASSWORD}，
#   也就是说后端实际是用 **MySQL root 账号**连库的（演示环境取舍，生产应改为最小权限专用用户）。
#   你自己设的 MYSQL_PASSWORD 会被 compose 覆盖，永远不会生效，故移除以免误导。
#   要改后端连库口令，就改下面的 MYSQL_ROOT_PASSWORD。

# ── MySQL 容器初始化（仅 docker-compose 用；决定容器 root 口令与首次建库）──
# 不再保留 "WorkOrder@2026" 这类真实感默认值：留默认值等于把口令写进公开历史
MYSQL_ROOT_PASSWORD=<required>

# ── Redis（当前已被代码消费：spring.data.redis + Sa-Token 会话）──
# 同上：compose 部署时默认填 redis / 6379；写 localhost 会让容器连自己。
REDIS_HOST=<optional:localhost>
REDIS_PORT=<optional:6379>

# ── LLM 智能分诊（当前已被代码消费：OrderTriageServiceImpl 读取 llm.api.url/key）──
# 为空时的行为：triage **降级**为 OTHER/普通，**提交仍然成功**（这是设计好的降级路径，不是故障）。
# 但它以前是"静默降级"——容器里没传这两个变量时，现象是"AI 把所有单都判成 OTHER"且日志无异常。现在有两道可见性：
#   ① 启动期 WARN（"未配置 LLM_API_URL/LLM_API_KEY，triage 将始终降级…"）；
#   ② 部署冒烟项"容器内这两个变量非空"（见 deploy/UPGRADE-P1.md §6）。
# ⚠ compose 部署时**必须在 .env 里填**这两个键：compose 用 `${LLM_API_URL:-}` 传进容器，留空即降级态（D57）。
LLM_API_URL=<optional:空>
LLM_API_KEY=<optional:空>
# 模型名：**必须显式配置，且要与 LLM_API_URL 所属供应商支持的模型名一致**（写错 → 每次调用 400 → 静默降级）。
# 这里给的是示例值，不是默认值：代码里**故意没有默认模型名**，因为默认值必然指向某一家供应商，
# 换一家就会 400——"指向错误目标的默认值比没有默认值更糟"（见 D58）。
# 例：DeepSeek 用 deepseek-flash / deepseek-v4-pro；OpenAI 用 gpt-4o-mini 等。
LLM_MODEL=deepseek-flash

# ── RabbitMQ（P1 步骤 3 起**已被代码消费**：application.yml 的 spring.rabbitmq 段）──
# RABBITMQ_HOST/PORT：后端连 broker 的地址。
#   · 走 compose 部署：**留空**，compose 会填容器网络内的服务名 rabbitmq / 5672。
#     千万别在这里写 localhost——容器里的 localhost 指容器自己，会连不上。
#   · 后端在本机直接跑（不通过 compose）：留空，默认 localhost:5672。
RABBITMQ_HOST=<optional:留空>
RABBITMQ_PORT=<optional:留空>
# RABBITMQ_USER/PASS：broker 的账号口令。
#   注意：**不能用 guest**。RabbitMQ 只允许 guest 从 loopback 登录，容器之间连不通会被拒绝。
#   compose 里 RABBITMQ_PASS 是 required（缺了直接报错退出），因为它是真实可登录的凭据。
RABBITMQ_USER=<optional:workorder>
RABBITMQ_PASS=<required>

# ── outbox 投递任务开关（P1 步骤 3）──
# false（默认）：不连 broker、不改 outbox 状态——本地与 CI 用这个，保证没有 broker 也能启动/跑测试。
# true：生产用。compose 已显式传 true，本地直接跑后端时若要验证投递链路再手动开。
OUTBOX_DISPATCH_ENABLED=<optional:false>

# ── XXL-Job 调度中心（P2 步骤 1 起：compose 第 6 个服务 xxl-job-admin）──
# XXL_JOB_ACCESS_TOKEN：管理台与执行器之间的通信口令。
#   · **允许为空**（`${XXL_JOB_ACCESS_TOKEN:-}`，不是 `:?`）：本轮只起管理台，空值也能跑起来；
#     若设成 required，"只想看看管理台"的本地/CI 环境会直接起不来——与 LLM 两个键同一取舍（D57）。
#   · **接执行器（P2 步骤 2）之前必须设置成非空，且与后端 `xxl.job.access-token` 同值**，否则执行器注册会被拒；
#     **留空仅限"只起管理台"的本地/本轮场景**（管理台自己不需要 token 就能打开控制台）。
#   · 库与账号口令**不需要新增键**：admin 连的是同一个 MySQL 实例上的 `xxl_job` 库，
#     账号口令复用 MYSQL_USER / MYSQL_ROOT_PASSWORD（与后端同一条演示环境取舍，见 D30 与 README §5.5）。
XXL_JOB_ACCESS_TOKEN=<optional:留空>

# ── 测试专用（仅 mvn test 时使用；见 src/test/resources/application-test.yml）──
# 测试必须用独立的库与独立的 Redis DB，避免污染业务库/清掉应用正在用的键
TEST_DB_NAME=<optional:work_order_test>
TEST_REDIS_DB=<optional:1>
